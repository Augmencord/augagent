{
  "name": "aughome-ide",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.js",
  "scripts": {
    "vite:dev": "vite",
    "vite:build": "vite build",
    "electron:dev": "set NODE_ENV=development&& electron .",
    "dev": "concurrently -k \"npm run vite:dev\" \"wait-on tcp:5173 && npm run electron:dev\"",
    "build": "npm run vite:build && electron-builder"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
